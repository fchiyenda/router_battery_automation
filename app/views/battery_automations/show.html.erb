<%= turbo_stream_from "battery_automation" %>

<main class="container">
  <header class="page-head">
    <h1>Router battery monitor</h1>
    <%= render "battery_automations/automation", setting: @setting %>
  </header>

  <% if flash[:notice] %><div class="banner banner-ok"><%= flash[:notice] %></div><% end %>
  <% if flash[:alert] %><div class="banner banner-bad"><%= flash[:alert] %></div><% end %>

  <%= render "battery_automations/error", setting: @setting %>

  <div class="grid">
    <%= render "battery_automations/battery", setting: @setting, latest: @latest %>

    <section class="card">
      <h2>Smart plug</h2>
      <%= render "battery_automations/plug_state", setting: @setting %>
      <div class="actions">
        <%= button_to "Plug ON", plug_on_battery_automation_path, method: :post, class: "btn btn-on" %>
        <%= button_to "Plug OFF", plug_off_battery_automation_path, method: :post, class: "btn btn-off" %>
        <%= button_to "Toggle automation", toggle_battery_automation_path, method: :post, class: "btn" %>
      </div>
    </section>

    <section class="card">
      <h2>Status</h2>
      <%= render "battery_automations/status", setting: @setting %>
    </section>
  </div>

  <section class="card wide">
    <h2>Last 24 hours</h2>
    <div class="chart-box"><canvas id="chart"></canvas></div>
  </section>

  <section class="card wide" id="settings">
    <h2>Settings</h2>
    <%= form_with model: @setting, url: battery_automation_path, method: :patch, scope: :battery_automation_setting do |f| %>
      <div class="fields">
        <div>
          <%= f.label :battery_scale_max, "Router battery steps" %>
          <%= f.select :battery_scale_max, [["4 steps (0 to 4)", 4], ["Real percent (0 to 100)", 100]] %>
          <small>How the router reports its battery</small>
        </div>
        <div>
          <%= f.label :step_percents, "Percent for each step" %>
          <%= f.text_field :step_percents %>
          <small>Step 0 to 4, e.g. 0,25,50,75,100. Used with 4 steps.</small>
        </div>
        <div>
          <%= f.label :start_charging_at, "Start charging at (%)" %>
          <%= f.number_field :start_charging_at, min: 0, max: 100 %>
          <small>Match one of the step percents</small>
        </div>
        <div>
          <%= f.label :stop_charging_at, "Stop charging at (%)" %>
          <%= f.number_field :stop_charging_at, min: 1, max: 100 %>
        </div>
        <div>
          <%= f.label :monitoring_interval, "Check every (seconds)" %>
          <%= f.number_field :monitoring_interval, min: 15 %>
        </div>
        <div>
          <%= f.label :confirmations_required, "Readings to confirm" %>
          <%= f.number_field :confirmations_required, min: 1, max: 5 %>
        </div>
        <div>
          <%= f.label :use_charge_full, "Also stop when router says full" %>
          <%= f.check_box :use_charge_full %>
          <small>Uses the router's battery_charge_full flag</small>
        </div>
      </div>
      <div class="form-foot"><%= f.submit "Save settings" %></div>
    <% end %>
  </section>

  <% if @calibration.any? %>
    <section class="card wide">
      <h2>Step calibration</h2>
      <%= render "battery_automations/calibration", rows: @calibration %>
    </section>
  <% end %>

  <div class="grid">
    <section class="card">
      <h2>Router fields (latest reading)</h2>
      <%= render "battery_automations/fields", latest: @latest %>
    </section>

    <section class="card">
      <h2>Recent events</h2>
      <%= render "battery_automations/events", events: @events %>
    </section>
  </div>
</main>

<div id="chart-feed" hidden><%= raw @readings.map { |t, l| { x: t.iso8601, y: l } }.to_json %></div>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1"></script>
<script>
  (function () {
    const STEPPED = <%= @setting.battery_scale_max < 100 %>;
    const feed = document.getElementById("chart-feed");

    const readRows = () => { try { return JSON.parse(feed.textContent); } catch (e) { return null; } };
    const labelsOf = (rows) => rows.map(r => new Date(r.x).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" }));

    const rows = readRows() || [];
    const chart = new Chart(document.getElementById("chart"), {
      type: "line",
      data: {
        labels: labelsOf(rows),
        datasets: [{ label: "Battery %", data: rows.map(r => r.y), borderColor: "#2f9e6e",
                     backgroundColor: "rgba(47,158,110,.12)", fill: true, pointRadius: 0, tension: 0.25,
                     stepped: STEPPED }]
      },
      options: {
        responsive: true, maintainAspectRatio: false,
        plugins: { legend: { display: false } },
        scales: { y: { min: 0, max: 100, ticks: { stepSize: 25 } }, x: { ticks: { maxTicksLimit: 8 } } }
      }
    });

    // The server pushes new chart data into #chart-feed over the WebSocket.
    new MutationObserver(() => {
      const r = readRows();
      if (!r) return;
      chart.data.labels = labelsOf(r);
      chart.data.datasets[0].data = r.map(x => x.y);
      chart.update("none");
    }).observe(feed, { childList: true, characterData: true, subtree: true });

    // "5 min ago" labels keep ticking between pushes.
    const ago = (iso) => {
      const s = Math.max(0, Math.round((Date.now() - new Date(iso)) / 1000));
      if (s < 60) return "just now";
      if (s < 3600) return Math.floor(s / 60) + " min ago";
      if (s < 86400) return Math.floor(s / 3600) + " h ago";
      return Math.floor(s / 86400) + " d ago";
    };
    const tick = () => document.querySelectorAll("[data-ago]").forEach(el => { el.textContent = ago(el.dataset.ago); });
    clearInterval(window.__batteryTick);
    window.__batteryTick = setInterval(tick, 5000);
    document.addEventListener("turbo:before-stream-render", () => setTimeout(tick, 0));
    tick();
  })();
</script>